# Deployer wallet private key — with or without "0x" prefix both work
# Example: PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae7248bf8bf77
PRIVATE_KEY=

# Sepolia RPC URL (Alchemy, Infura, or public endpoint)
# Example: SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Example: SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_RPC_URL=

# Etherscan API key for contract verification on Sepolia (optional for deploy)
ETHERSCAN_API_KEY=
